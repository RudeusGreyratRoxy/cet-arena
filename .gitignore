# 本项目统一使用 pnpm-lock.yaml；服务器上用 npm install 生成的锁文件不入库
package-lock.json

# 激活码运行状态（含绑定 IP / 设备），只在服务器本地保存，绝不入库
data/vip_codes.state.json

# 站长留言板数据（含用户反馈与设备指纹），只在服务器本地保存
data/messages.json

# 首页公告（站长后台发布，属运行时状态，入库会造成 pull 冲突）
data/announcement.json

# 测试用临时目录
test/.tmp-*

# 本地生成物：词库备份、词库体检报告
